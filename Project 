      "source": [
        "**Preprocess the flower dataset(resize, normalized and augment image)**"
      ],
      "metadata": {
        "id": "6W0ThYj4IIyb"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import tensorflow as tf\n",
        "import tensorflow_datasets as tfds\n",
        "from tensorflow.keras import layers\n",
        "\n",
        "# Download the flower dataset from TensorFlow Datasets\n",
        "dataset, info = tfds.load('tf_flowers', with_info=True, as_supervised=True)\n",
        "\n",
        "# Check available splits (to confirm the available splits)\n",
        "print(info.splits)\n",
        "\n",
        "# Split the dataset into training and validation datasets (if only 'train' split is available)\n",
        "train_ds = dataset['train']\n",
        "\n",
        "# Manually split the 'train' dataset into training and validation sets\n",
        "val_size = 0.2  # 20% for validation\n",
        "train_size = 1 - val_size\n",
        "\n",
        "train_ds = train_ds.take(int(len(train_ds) * train_size))  # Take 80% for training\n",
        "val_ds = train_ds.skip(int(len(train_ds) * train_size))    # Take 20% for validation\n",
        "\n",
        "# Preprocessing function (resize and normalize)\n",
        "def preprocess(image, label):\n",
        "    # Resize images to 180x180\n",
        "    image = tf.image.resize(image, (180, 180))\n",
        "    # Normalize images to [0, 1]\n",
        "    image = image / 255.0\n",
        "    return image, label\n",
        "\n",
        "# Data Augmentation function (random transformations)\n",
        "def augment(image, label):\n",
        "    # Randomly flip images horizontally\n",
        "    image = tf.image.random_flip_left_right(image)\n",
        "    # Randomly adjust the brightness of images\n",
        "    image = tf.image.random_brightness(image, max_delta=0.2)\n",
        "    # Randomly adjust the contrast of images\n",
        "    image = tf.image.random_contrast(image, lower=0.8, upper=1.2)\n",
        "    # Randomly adjust the saturation of images\n",
        "    image = tf.image.random_saturation(image, lower=0.8, upper=1.2)\n",
        "    return image, label\n",
        "\n",
        "# Apply preprocessing and augmentation to the train dataset\n",
        "train_ds = train_ds.map(preprocess)  # Apply resize and normalize\n",
        "train_ds = train_ds.map(augment)    # Apply data augmentation\n",
        "train_ds = train_ds.batch(32)       # Batch the dataset (32 images at a time)\n",
        "train_ds = train_ds.shuffle(1000)   # Shuffle the training dataset\n",
        "train_ds = train_ds.prefetch(tf.data.experimental.AUTOTUNE)  # Prefetch for performance optimization\n",
        "\n",
        "# Apply preprocessing to the validation dataset (no augmentation for validation data)\n",
        "val_ds = val_ds.map(preprocess)\n",
        "val_ds = val_ds.batch(32)\n",
        "val_ds = val_ds.prefetch(tf.data.experimental.AUTOTUNE)\n",
        "\n",
        "# Now train_ds and val_ds are ready for model training\n"
      ],
