    {
      "cell_type": "code",
      "source": [
        "import tensorflow as tf\n",
        "import tensorflow_datasets as tfds\n",
        "import numpy as np\n",
        "from sklearn.svm import SVC\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import accuracy_score\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# Download the flower dataset from TensorFlow Datasets\n",
        "dataset, info = tfds.load('tf_flowers', with_info=True, as_supervised=True)\n",
        "\n",
        "# Extract the training dataset\n",
        "train_ds = dataset['train']\n",
        "\n",
        "# Preprocessing function (resize and normalize)\n",
        "def preprocess(image, label):\n",
        "    # Resize images to 180x180\n",
        "    image = tf.image.resize(image, (180, 180))\n",
        "    # Normalize images to [0, 1]\n",
        "    image = image / 255.0\n",
        "    return image, label\n",
        "\n",
        "# Apply preprocessing to the train dataset\n",
        "train_ds = train_ds.map(preprocess)\n",
        "train_ds = train_ds.batch(32).prefetch(tf.data.experimental.AUTOTUNE)\n",
        "\n",
        "# Convert the dataset into numpy arrays for classical ML models\n",
        "images = []\n",
        "labels = []\n",
        "\n",
        "for image, label in train_ds:\n",
        "    images.append(image.numpy())\n",
        "    labels.append(label.numpy())\n",
        "\n",
        "# Convert lists to numpy arrays\n",
        "X = np.concatenate(images, axis=0)\n",
        "y = np.concatenate(labels, axis=0)\n",
        "\n",
        "# Flatten the images for classical ML models (1D vector)\n",
        "X_flattened = X.reshape(X.shape[0], -1)  # Flatten images into 1D vectors\n",
        "\n",
        "# Normalize the feature matrix (important for SVM)\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X_flattened)\n",
        "\n",
        "# Split data into train and test sets\n",
        "X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)\n",
        "\n",
        "# ---------------------------------------\n",
        "# SVM Model\n",
        "svm = SVC(kernel='linear')  # Linear SVM\n",
        "svm.fit(X_train, y_train)\n",
        "\n",
        "# Make predictions and evaluate\n",
        "y_pred_svm = svm.predict(X_test)\n",
        "svm_accuracy = accuracy_score(y_test, y_pred_svm)\n",
        "print(f\"SVM Model Accuracy: {svm_accuracy:.4f}\")\n",
        "\n",
        "# ---------------------------------------\n",
        "# Decision Tree Model\n",
        "dt = DecisionTreeClassifier(random_state=42)\n",
        "dt.fit(X_train, y_train)\n",
        "\n",
        "# Make predictions and evaluate\n",
        "y_pred_dt = dt.predict(X_test)\n",
        "dt_accuracy = accuracy_score(y_test, y_pred_dt)\n",
        "print(f\"Decision Tree Model Accuracy: {dt_accuracy:.4f}\")\n",
        "\n",
        "# ---------------------------------------\n",
        "# Random Forest Model\n",
        "rf = RandomForestClassifier(n_estimators=100, random_state=42)\n",
        "rf.fit(X_train, y_train)\n",
        "\n",
        "# Make predictions and evaluate\n",
        "y_pred_rf = rf.predict(X_test)\n",
        "rf_accuracy = accuracy_score(y_test, y_pred_rf)\n",
        "print(f\"Random Forest Model Accuracy: {rf_accuracy:.4f}\")\n"
      ],
